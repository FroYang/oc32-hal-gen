{
    "name": "CV32S6015U",
    "ihosc_freq": 24000000,
    "ilosc_freq": 4000,
    "cdr_freq": 12000000,
    "sclk_freq": 99000000,
    "flash_size": 256,
    "zone0_size": 30,
    "zone1_size": 98,
    "int_priority": 4,
    "dma_channels": 4,
    "dma_map": [
        "SPI0", "SPI1", "IIC", "UART0", "UART1", "ADC0",
        "MPWM0", "MPWM1", "MPWM2", "FLASH", "DAC0", "ADC1",
        "DAC1", "reserved0", "reserved1", "CRC"
    ],
    "hic_map": [
        "SERR", "CMP0", "CMP1", "CCP0", "CCP1", "CCP2", "CCP3", "CCP4", 
        "CCP5", "TIMER0", "TIMER1", "TIMER2", "TIMER3",  "TIMER4", "TIMER5", "TIMER6",
        "TIMER7", "WDT", "ADC0", "ADC1", "UART0", "UART1", "SPI0", "SPI1",
        "IIC", "MPWM0", "MPWM1", "MPWM2", "DAC", "CRC", "PORTA", "PORTB"
    ],
    "vdd_value": 5000,
    "features": [
        {
            "key": "PORTB",
            "description": "GPIO Port B",
            "always": true
        },
        {
            "key": "CRC",
            "description": "CRC Calculator",
            "always": false
        },
        {
            "key": "FLASH",
            "description": "Read/Write Flash",
            "always": false,
            "dependencies": [
                "CRC"
            ]
        },
        {
            "key": "FLASH_VERIFY",
            "description": "Verify Flash Code",
            "always": false,
            "macro_name": "FLASH_VERIFY",
            "dependencies": [
                "FLASH", "CRC"
            ]
        },
        {
            "key": "LVD",
            "description": "Low Voltage Detector",
            "always": false
        },
        {
            "key": "UART",
            "description": "UART",
            "always": false
        },
        {
            "key": "TIMER",
            "description": "Timer",
            "always": false
        },
        {
            "key": "USB",
            "description": "Fullspeed USB",
            "always": false
        },
        {
            "key": "RCM_CDR",
            "description": "RCM Use USB CDR",
            "always": false,
            "macro_name": "RCM_CDR",
            "dependencies": [
                "USB"
            ]
        },
        {
            "key": "DEBUG",
            "description": "Debug Printf Via UART",
            "always": false,
            "dependencies": [
                "UART"
            ]
        }
    ]
}