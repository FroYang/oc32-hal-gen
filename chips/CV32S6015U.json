{
    "name": "CV32S6015U",
    "ihosc_freq": 24000000,
    "ilosc_freq": 4000,
    "sclk_freq": 99000000,
    "flash_size": 256,
    "zone0_size": 30,
    "zone1_size": 98,
    "int_priority": 4,
    "dma_channels": 4,
    "dma_map0": "SPI0",
    "dma_map1": "SPI1",
    "dma_map2": "IIC",
    "dma_map3": "UART0",
    "dma_map4": "UART1",
    "dma_map5": "ADC0",
    "dma_map6": "MPWM0",
    "dma_map7": "MPWM1",
    "dma_map8": "MPWM2",
    "dma_map9": "FLASH",
    "dma_map10": "DAC0",
    "dma_map11": "ADC1",
    "dma_map12": "DAC1",
    "dma_map13": "reserved0",
    "dma_map14": "reserved1",
    "dma_map15": "CRC",
    "vdd_value": 5000,
    "features": [
        {
            "key": "PORT_B",
            "description": "GPIO Port B",
            "always": true
        },
        {
            "key": "CRC",
            "description": "CRC Calculator",
            "always": false
        },
        {
            "key": "FLASH",
            "description": "Read/Write Flash",
            "always": false,
            "dependencies": [
                "CRC"
            ]
        },
        {
            "key": "FLASH_VERIFY",
            "description": "Verify Flash Code",
            "always": false,
            "macro_name": "FLASH_VERIFY",
            "dependencies": [
                "FLASH", "CRC"
            ]
        },
        {
            "key": "LVD",
            "description": "Low Voltage Detector",
            "always": false
        },
        {
            "key": "VTS",
            "description": "Voltage Temperature Sensor",
            "always": false
        },
        {
            "key": "UART",
            "description": "UART",
            "always": false
        },
        {
            "key": "TIMER",
            "description": "Timer",
            "always": false
        },
        {
            "key": "USB",
            "description": "Fullspeed USB",
            "always": false
        },
        {
            "key": "RCM_CDR",
            "description": "RCM Use USB CDR",
            "always": false,
            "macro_name": "RCM_CDR",
            "dependencies": [
                "USB"
            ]
        },
        {
            "key": "DEBUG",
            "description": "Debug Printf Via UART",
            "always": false,
            "dependencies": [
                "UART"
            ]
        }
    ]
}